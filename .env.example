# Stripe Configuration
# Get your keys from https://dashboard.stripe.com/apikeys

# Secret key (starts with sk_live_ for production, sk_test_ for testing)
STRIPE_SECRET_KEY=sk_test_your_secret_key

# Publishable key (starts with pk_live_ for production, pk_test_ for testing)
STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key

# Webhook secret (from Stripe Webhooks dashboard after creating a webhook)
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# For local development with Stripe CLI:
# Run: stripe listen --forward-to mahita.ai/api/webhook
# Copy the webhook secret it gives you

# Schwab API Configuration
# Get your credentials from https://developer.schwab.com/
SCHWAB_CLIENT_ID=your_schwab_client_id
SCHWAB_CLIENT_SECRET=your_schwab_client_secret
SCHWAB_CALLBACK_URL=https://mahita.ai/schwab/callback
MAHITA_PUBLIC_APP_ORIGIN=https://mahita.ai
MAHITA_SECRET_KEY=your_app_encryption_key
