datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// NextAuth Models
model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?
  access_token       String?
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]
  strategies    Strategy[]
  schwabConfig  SchwabConfig?
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// Schwab API Configuration
model SchwabConfig {
  id                String   @id @default(cuid())
  userId            String   @unique
  clientId          String
  clientSecret      String
  accessToken       String?
  refreshToken      String?
  accessTokenExpiry DateTime?
  refreshTokenExpiry DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Custom Trading Models
model Strategy {
  id              String   @id @default(cuid())
  userId          String
  name            String
  description     String?
  asset           String
  timeframe       String
  astJson         String   // Stringified AST JSON defining entry/exit rules
  riskManagement  String   // Stringified JSON defining stopLoss, target
  isLiveDeployed  Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  trades Trade[]
}

model Trade {
  id            String   @id @default(cuid())
  strategyId    String
  symbol        String
  side          String   // "Long" | "Short"
  entryTime     DateTime
  entryPrice    Float
  exitTime      DateTime?
  exitPrice     Float?
  quantity      Float
  pnl           Float?
  status        String   // "Open" | "Closed" | "Canceled"

  strategy Strategy @relation(fields: [strategyId], references: [id], onDelete: Cascade)
}

model MarketData {
  id        String   @id @default(cuid())
  symbol    String
  timeframe String
  time      DateTime
  open      Float
  high      Float
  low       Float
  close     Float
  volume    Float
  source    String   @default("unknown")

  @@unique([symbol, timeframe, time])
  @@index([symbol, timeframe, time])
}

model DataInventory {
  id          String   @id @default(cuid())
  symbol      String
  timeframe   String
  lastSynced  DateTime @default(now())
  source      String   @default("unknown")
  firstBar    DateTime?
  lastBar     DateTime?
  healthScore Float    @default(0)
  barCount    Int      @default(0)
  gapCount    Int      @default(0)

  @@unique([symbol, timeframe])
}
