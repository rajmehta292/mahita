datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum UserRole {
  USER
  ADMIN
  SUPERUSER
}

enum ProviderCredentialSourceType {
  DEDICATED
  USER_SCHWAB_CONFIG
}

enum ProviderPoolPurpose {
  MARKET_DATA
}

enum ProviderPoolMemberStatus {
  ACTIVE
  DISABLED
  DEGRADED
}

enum BrokerageConnectionProvider {
  SCHWAB
}

enum BrokerageConnectionStatus {
  CONFIGURED
  AUTHORIZED
  DEGRADED
  DISCONNECTED
}

// NextAuth Models
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id                String            @id @default(cuid())
  name              String?
  email             String?           @unique
  emailVerified     DateTime?
  image             String?
  role              UserRole          @default(USER)
  accounts          Account[]
  sessions          Session[]
  strategies        Strategy[]
  schwabConfig      SchwabConfig?
  brokerageConnections BrokerageConnection[]
  preferences       UserPreference?
  aiKeys            AIKey[]
  aiUsage           AIUsage[]
  investorProfile   InvestorProfile?
  adminAuditEvents  AdminAuditEvent[] @relation("AdminActor")
  adminAuditTargets AdminAuditEvent[] @relation("AdminTarget")
  adminSecretRevealGrants AdminSecretRevealGrant[] @relation("AdminSecretRevealActor")
  providerCredentialsCreated ProviderCredential[] @relation("ProviderCredentialCreator")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// Schwab API Configuration
model SchwabConfig {
  id                 String    @id @default(cuid())
  userId             String    @unique
  clientId           String
  clientSecret       String
  accessToken        String?
  refreshToken       String?
  accessTokenExpiry  DateTime?
  refreshTokenExpiry DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  user                User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  brokerageConnection BrokerageConnection?
  providerCredentials ProviderCredential[]
}

model BrokerageConnection {
  id                  String                     @id @default(cuid())
  userId              String
  provider            BrokerageConnectionProvider @default(SCHWAB)
  label               String?
  status              BrokerageConnectionStatus @default(CONFIGURED)
  linkedSchwabConfigId String?                  @unique
  isPrimary           Boolean                   @default(true)
  pendingAuthState    String?
  pendingAuthStartedAt DateTime?
  lastSyncedAt        DateTime?
  lastError           String?
  createdAt           DateTime                  @default(now())
  updatedAt           DateTime                  @updatedAt

  user              User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  linkedSchwabConfig SchwabConfig? @relation(fields: [linkedSchwabConfigId], references: [id], onDelete: SetNull)
  accounts          BrokerageAccount[]

  @@unique([userId, provider])
  @@index([provider, status])
}

model BrokerageAccount {
  id                   String   @id @default(cuid())
  brokerageConnectionId String
  providerAccountId    String
  accountHash          String?
  accountNumber        String?
  accountType          String?
  displayName          String?
  isActive             Boolean  @default(true)
  rawSnapshot          String?
  lastSyncedAt         DateTime?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  brokerageConnection BrokerageConnection @relation(fields: [brokerageConnectionId], references: [id], onDelete: Cascade)

  @@unique([brokerageConnectionId, providerAccountId])
  @@index([brokerageConnectionId, isActive])
  @@index([brokerageConnectionId, accountHash])
}

model ProviderCredential {
  id                  String                       @id @default(cuid())
  provider            String
  label               String
  sourceType          ProviderCredentialSourceType @default(DEDICATED)
  createdByUserId     String?
  linkedSchwabConfigId String?                    @unique
  clientId            String?
  clientSecret        String?
  accessToken         String?
  refreshToken        String?
  accessTokenExpiry   DateTime?
  refreshTokenExpiry  DateTime?
  isEnabled           Boolean                      @default(true)
  notes               String?
  lastValidatedAt     DateTime?
  lastValidationError String?
  createdAt           DateTime                     @default(now())
  updatedAt           DateTime                     @updatedAt

  createdByUser   User?         @relation("ProviderCredentialCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  linkedSchwabConfig SchwabConfig? @relation(fields: [linkedSchwabConfigId], references: [id], onDelete: SetNull)
  poolMembers     ProviderPoolMember[]
  revealGrants    AdminSecretRevealGrant[]

  @@index([provider, isEnabled])
}

model ProviderPoolMember {
  id                   String                   @id @default(cuid())
  providerCredentialId String
  purpose              ProviderPoolPurpose      @default(MARKET_DATA)
  label                String?
  priority             Int                      @default(100)
  weight               Int                      @default(1)
  status               ProviderPoolMemberStatus @default(ACTIVE)
  isPrimary            Boolean                  @default(false)
  createdAt            DateTime                 @default(now())
  updatedAt            DateTime                 @updatedAt

  providerCredential ProviderCredential @relation(fields: [providerCredentialId], references: [id], onDelete: Cascade)

  @@unique([providerCredentialId, purpose])
  @@index([purpose, status, priority])
}

model UserPreference {
  id                     String   @id @default(cuid())
  userId                 String   @unique
  selectedAccountId      String?
  portfolioColumns       String?
  portfolioSortKey       String?
  portfolioSortDirection String?
  dashboardLayout        String?
  watchlistSymbols       String?
  trendingStrategyIds    String?
  lastVisitedPath        String?
  lastVisitedAt          DateTime?
  lastSignInAt           DateTime?
  previousSignInAt       DateTime?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AIKey {
  id        String   @id @default(cuid())
  userId    String
  provider  String
  label     String?
  key       String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider])
}

model AIUsage {
  id         String   @id @default(cuid())
  userId     String
  provider   String
  modelId    String
  tokenCount Int      @default(0)
  isByok     Boolean  @default(false)
  metadata   String?
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model InvestorProfile {
  id                      String   @id @default(cuid())
  userId                  String   @unique
  lifeStage               String?
  timeHorizon             String?
  riskTolerance           String?
  liquidityNeeds          String?
  taxSensitivity          String?
  objective               String?
  alphaPromptsEnabled     Boolean  @default(true)
  minProfitThresholdPct   Float?
  proposalCooldownMinutes Int?
  accountScope            String?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AdminAuditEvent {
  id           String   @id @default(cuid())
  actorUserId  String
  targetUserId String?
  action       String
  reason       String?
  metadata     String?
  createdAt    DateTime @default(now())

  actorUser  User  @relation("AdminActor", fields: [actorUserId], references: [id], onDelete: Cascade)
  targetUser User? @relation("AdminTarget", fields: [targetUserId], references: [id], onDelete: SetNull)

  @@index([actorUserId, createdAt])
  @@index([targetUserId, createdAt])
}

model AdminSecretRevealGrant {
  id                  String   @id @default(cuid())
  actorUserId         String
  providerCredentialId String
  targetUserId        String?
  reason              String
  expiresAt           DateTime
  revokedAt           DateTime?
  createdAt           DateTime @default(now())

  actorUser          User              @relation("AdminSecretRevealActor", fields: [actorUserId], references: [id], onDelete: Cascade)
  providerCredential ProviderCredential @relation(fields: [providerCredentialId], references: [id], onDelete: Cascade)

  @@index([actorUserId, createdAt])
  @@index([providerCredentialId, expiresAt])
}

// Custom Trading Models
model Strategy {
  id             String   @id @default(cuid())
  userId         String
  name           String
  description    String?
  asset          String
  timeframe      String
  astJson        String // Stringified AST JSON defining entry/exit rules
  riskManagement String // Stringified JSON defining stopLoss, target
  isLiveDeployed Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  trades Trade[]
}

model Trade {
  id         String    @id @default(cuid())
  strategyId String
  symbol     String
  side       String // "Long" | "Short"
  entryTime  DateTime
  entryPrice Float
  exitTime   DateTime?
  exitPrice  Float?
  quantity   Float
  pnl        Float?
  status     String // "Open" | "Closed" | "Canceled"

  strategy Strategy @relation(fields: [strategyId], references: [id], onDelete: Cascade)
}

model MarketData {
  id        String   @id @default(cuid())
  symbol    String
  timeframe String
  time      DateTime
  open      Float
  high      Float
  low       Float
  close     Float
  volume    Float
  source    String   @default("unknown")

  @@unique([symbol, timeframe, time])
  @@index([symbol, timeframe, time])
}

model Vault {
  id          String   @id @default(cuid())
  name        String   @unique // "schwab", "yahoo", "google", "ollama", "csv", "master"
  type        String   // "provider", "ai", "manual", "master"
  dbPath      String?  // Path to the sqlite file
  isEnabled   Boolean  @default(true)
  lastSyncAt  DateTime?
  metadata    String?  // JSON for extra config
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  inventories DataInventory[]
}

model DataInventory {
  id                    String    @id @default(cuid())
  vaultId               String?   // Link to the vault this inventory belongs to
  symbol                String
  timeframe             String
  lastSynced            DateTime  @default(now())
  source                String    @default("unknown")
  firstBar              DateTime?
  lastBar               DateTime?
  healthScore           Float     @default(0)
  targetCoveragePercent Float     @default(0)
  barCount              Int       @default(0)
  gapCount              Int       @default(0)

  vault Vault? @relation(fields: [vaultId], references: [id], onDelete: SetNull)

  @@unique([vaultId, symbol, timeframe])
}

// V2 Data Engine Metadata Catalog

model SymbolRegistry {
  id              String   @id @default(cuid())
  symbol          String   @unique
  assetClass      String // "equity", "crypto", "forex"
  exchange        String?
  providerSymbols String? // Stringified JSON mapping
  enabled         Boolean  @default(true)
  priority        Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  partitions DataPartition[]
  spans      DataSpan[]
}

model DataPartition {
  id               String    @id @default(cuid())
  symbolRegistryId String
  symbol           String
  timeframe        String
  partitionDate    DateTime // Truncated to midnight UTC
  filePath         String // e.g. "data/lake/equity/AAPL/1m/2026/03/07/bars.parquet"
  source           String
  isRaw            Boolean   @default(true)
  rowCount         Int       @default(0)
  firstBarTime     DateTime?
  lastBarTime      DateTime?
  checksum         String?
  isComplete       Boolean   @default(false)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  symbolRef SymbolRegistry @relation(fields: [symbolRegistryId], references: [id], onDelete: Cascade)

  @@unique([symbol, timeframe, partitionDate, source])
  @@index([symbol, timeframe, partitionDate])
}

model DataSpan {
  id               String   @id @default(cuid())
  symbolRegistryId String
  symbol           String
  timeframe        String
  source           String
  startTime        DateTime
  endTime          DateTime
  isDerived        Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  symbolRef SymbolRegistry @relation(fields: [symbolRegistryId], references: [id], onDelete: Cascade)

  @@unique([symbol, timeframe, source, startTime])
}

model IngestionJob {
  id           String    @id @default(cuid())
  type         String // "bootstrap", "backfill", "catchup", "derive"
  symbol       String
  timeframe    String?
  status       String // "queued", "running", "completed", "failed"
  targetStart  DateTime?
  targetEnd    DateTime?
  progressPerc Float     @default(0)
  error        String?
  logs         String?
  startedAt    DateTime?
  completedAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  events IngestionEvent[]
}

model IngestionEvent {
  id             String   @id @default(cuid())
  ingestionJobId String
  level          String // "info", "warn", "error"
  message        String
  meta           String?
  createdAt      DateTime @default(now())

  job IngestionJob @relation(fields: [ingestionJobId], references: [id], onDelete: Cascade)
}
